node_modules/
dist/*
!dist/BANNON.apk
# OTA payload the installed app fetches to self-update (published by android.yml on each main push).
# These MUST be tracked or the phone can never see a new build.
!dist/BANNON.html
!dist/version.json
fight_history.json
move_fitness.json
move_fitness.json.transitions
learned_content.json
fighter_profiles.json
forged_characters.json
mocap_metadata.json
*.log
.env
assets/models/incoming/

# built APK artifact — delivered via file card / regenerated by CI (android.yml), not committed
/BANNON.apk

tools/unirig/rerig_log.txt
tools/unirig/rerig_*.out
assets/models/*_rigged.glb.raw.glb

# MDickie APK extraction workspace — raw third-party games never committed
/tmp/mdickie_pull/
assets/mdickie_extracted/*.apk
assets/mdickie_extracted/raw/
__pycache__/

# DISC IMAGE staging — raw third-party disc contents, same rule as the MDickie APK workspace:
# the extractor's output is reference material, never committed. Nor are the images themselves,
# nor any key file. See tools/iso/README.md.
/iso_staging/
assets/iso_extracted/
*.iso
*.gcm
*.wbfs
*.cso
*.cue
tools/iso/*.key
tools/iso/*key*.bin
