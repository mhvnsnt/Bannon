node_modules/
dist/*
!dist/BANNON.apk
# The side-by-side "fresh id" APK — the one that installs when the normal package will not upgrade
# over what is already on the phone. android.yml publishes it next to BANNON.apk, so it has to be
# tracked. It was NOT, and `git add` on an ignored path exits 1, which killed the publish step of
# thirty consecutive builds before it could commit BANNON.apk, BANNON.html or version.json.
!dist/BANNON-fresh.apk
# OTA payload the installed app fetches to self-update (published by android.yml on each main push).
# These MUST be tracked or the phone can never see a new build.
!dist/BANNON.html
!dist/version.json
fight_history.json
move_fitness.json
move_fitness.json.transitions
learned_content.json
fighter_profiles.json
forged_characters.json
mocap_metadata.json
*.log
.env
assets/models/incoming/

# built APK artifact — delivered via file card / regenerated by CI (android.yml), not committed
/BANNON.apk

tools/unirig/rerig_log.txt
tools/unirig/rerig_*.out
assets/models/*_rigged.glb.raw.glb

# MDickie APK extraction workspace — raw third-party games never committed
/tmp/mdickie_pull/
assets/mdickie_extracted/*.apk
assets/mdickie_extracted/raw/
__pycache__/

# DISC IMAGE staging — raw third-party disc contents, same rule as the MDickie APK workspace:
# the extractor's output is reference material, never committed. Nor are the images themselves,
# nor any key file. See tools/iso/README.md.
/iso_staging/
assets/iso_extracted/
*.iso
*.gcm
*.wbfs
*.cso
*.cue
tools/iso/*.key
tools/iso/*key*.bin

# disc images + reference video dropped via drive_sync — raw third-party material, extracted then
# discarded. Only derived proprietary output is ever committed.
/iso_staging/
/mocap_video/

# per-character social video pulled by tools/mocap/scrape_clips.py — provenance lives in each
# manifest.json; nothing here ships until someone decides it should.
assets/mocap/social/

# local sessions/tokens for the social scraper — never commit
.claude/

# per-match segmentation output (review sheets + JSON) — regenerate from the video
assets/mocap/segments/

# playtest recordings — regenerate with tools/harness/play_and_record.cjs, don't bloat the repo
dist/playtest/
